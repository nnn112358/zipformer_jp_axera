{
  "model_type": "ONNX",
  "npu_mode": "NPU3",
  "target_hardware": "AX650",
  "quant": {
    "input_configs": [
      {
        "tensor_name": "input_values",
        "calibration_dataset": "./calibrations/input_values.tar.gz",
        "calibration_size": -1,
        "calibration_format": "Numpy"
      }
    ],
    "layer_configs": [
      {
        "start_tensor_names": ["DEFAULT"],
        "end_tensor_names": ["DEFAULT"],
        "data_type": "U16"
      },
      { "op_type": "Pow",        "data_type": "FP32" },
      { "op_type": "Sqrt",       "data_type": "FP32" },
      { "op_type": "ReduceMean", "data_type": "FP32" },
      { "op_type": "Add",        "data_type": "FP32" },
      { "op_type": "Softmax",    "data_type": "FP32" }
    ],
    "calibration_method": "Percentile",
    "enable_smooth_quant": true,
    "conv_bias_data_type": "FP32",
    "ln_scale_data_type": "FP32",
    "disable_auto_refine_scale": true,
    "precision_analysis": true,
    "precision_analysis_method": "EndToEnd",
    "transformer_opt_level": 1
  },
  "input_processors": [
    {"tensor_name": "DEFAULT"}
  ],
  "compiler": {"check": 0}
}
